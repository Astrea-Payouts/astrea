// Astrea data model — mirrors on-chain escrow state for UX/querying.
// The chain is the source of truth (see docs/architecture.md, Principle 2);
// this schema is a mirror kept honest by a reconciliation job (E04).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StellarNetwork {
  TESTNET
  MAINNET
}

/// Event lifecycle — see docs/product-flows.md "Event state machine".
enum EventStatus {
  DRAFT
  CREATED
  FUNDED
  LIVE
  JUDGING
  COMPLETED
  DISPUTED
  CANCELLED
}

/// Prize lifecycle — see docs/product-flows.md "Prize states".
/// RELEASED means the on-chain `release_reward` call already paid this
/// prize's winner directly — the contract has no approval step and no
/// forwarding hop (event-escrow/src/lib.rs `release_reward`; ADR-001, ADR-003).
/// PAID_OUT is kept as a separate terminal status for now, pending a decision
/// on whether it still means anything distinct from RELEASED now that there
/// is no forward payment to wait for — not resolved by this change.
enum PrizeStatus {
  PENDING
  ASSIGNED
  RELEASED
  PAID_OUT
  DISPUTED
}

enum JudgeStatus {
  ACTIVE
  REMOVED
}

/// Idempotency + outbox for every escrow-mutating operation (docs/architecture.md, Principle 4).
enum OpStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A person on the platform. Not yet tied to a specific auth mechanism —
/// wallet-based auth is designed in S05; kept minimal and independent until then.
model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  wallets         Wallet[]
  organizedEvents Event[]  @relation("EventOrganizer")

  @@map("users")
}

/// A Stellar address associated with a user. Judges are stored as raw addresses
/// on Judge.walletAddress instead (they may be a multisig the platform has no
/// Wallet row for — see docs/architecture.md ADR-003, multi-judge note).
model Wallet {
  id                      String    @id @default(uuid())
  userId                  String
  address                 String    @unique
  email                   String?
  usdcTrustlineVerifiedAt DateTime?
  createdAt               DateTime  @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizedEvents Event[]      @relation("EventOrganizerWallet")
  teamMemberships TeamMember[]

  @@index([userId])
  @@map("wallets")
}

model Event {
  id                   String         @id @default(uuid())
  organizerId          String
  organizerWalletId    String
  name                 String
  description          String?
  logoUrl              String?
  tagline              String?
  location             String?
  /// IANA identifier (e.g. "America/Costa_Rica"), not offset shorthand. The
  /// on-chain `deadline` is a ledger timestamp — UTC with no timezone of its
  /// own — and `expire_event` is permissionless: once it passes, anyone can
  /// call it and the reserved reward refunds to the organizer. Recording the
  /// timezone the organizer meant is what keeps a local "11:59 PM" from
  /// silently becoming a different UTC instant than intended.
  timezone             String         @default("UTC")
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  startsAt             DateTime?
  endsAt               DateTime?
  status               EventStatus    @default(DRAFT)
  conditionsMetAt      DateTime?
  network              StellarNetwork @default(TESTNET)
  escrowContractId     String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organizer       User    @relation("EventOrganizer", fields: [organizerId], references: [id])
  organizerWallet Wallet  @relation("EventOrganizerWallet", fields: [organizerWalletId], references: [id])
  prizes          Prize[]
  judges          Judge[]
  teams           Team[]

  @@index([organizerId])
  @@index([organizerWalletId])
  @@index([status])
  @@map("events")
}

/// winnerTeamId points at the Team that won this position, not a wallet —
/// release_reward pays a team's members directly and individually (see
/// Team/TeamMember), so "who won" and "who got paid" are no longer the same
/// column. Payout.teamMemberId is where individual payment lands.
model Prize {
  id            String      @id @default(uuid())
  eventId       String
  rank          Int
  amount        Decimal     @db.Decimal(18, 7)
  status        PrizeStatus @default(PENDING)
  winnerTeamId  String?
  releaseTxHash String?
  releasedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  winnerTeam Team?    @relation("PrizeWinner", fields: [winnerTeamId], references: [id])
  payouts    Payout[]

  @@unique([eventId, rank])
  @@index([eventId])
  @@index([winnerTeamId])
  @@index([status])
  @@map("prizes")
}

/// Judges map to the single on-chain `judge` address stored on the
/// contract's `Event` (ADR-003) — the only address `release_reward` requires
/// auth from, not a separate `approver` + `releaseSigner` pair.
/// walletAddress is a raw Stellar address, not a Wallet FK — it may be a
/// multisig account the platform has no user/Wallet row for. Multiple
/// `Judge` rows can represent a panel, but only one address ever reaches
/// the chain — see #62.
model Judge {
  id            String      @id @default(uuid())
  eventId       String
  walletAddress String
  displayName   String
  status        JudgeStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, walletAddress])
  @@index([eventId])
  @@map("judges")
}

/// A team entering an event — the unit of registration. A solo entrant is
/// represented as a team of one (see TeamMember); there is no separate
/// individual-participant path. submissionUrl lives here, not on a member,
/// because the team submits one project regardless of its size.
///
/// Share freeze: once Event.status leaves {DRAFT, CREATED, FUNDED, LIVE} —
/// i.e. once judging starts — a `team_members_enforce_freeze` trigger on
/// team_members (see migration) rejects any insert/update/delete against
/// this team's membership or shares. There is no `sharesLockedAt` column;
/// the freeze is derived from the event's own state machine rather than
/// tracked as separate data that could drift from it.
model Team {
  id            String   @id @default(uuid())
  eventId       String
  name          String
  submissionUrl String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  wonPrizes Prize[]      @relation("PrizeWinner")

  @@index([eventId])
  @@map("teams")
}

/// One member of a Team and their declared share of any prize the team
/// wins, set at registration and frozen once judging starts (see Team).
/// `eventId` duplicates `Team.eventId` on purpose: it is what lets "a
/// wallet may not be on two teams in the same event" be a plain SQL
/// UNIQUE constraint ([eventId, walletId]) instead of a cross-table
/// trigger. It is not modeled as its own Prisma relation to Event —
/// Team.event already covers navigation; this column exists only to
/// support that constraint.
model TeamMember {
  id      String @id @default(uuid())
  teamId  String
  eventId String

  walletId         String
  /// Share of the team's eventual prize, in basis points (1 bp = 0.01%;
  /// 10000 bp = 100%) — an integer, never a float or Decimal percentage,
  /// so a team's shares sum exactly. A team's rows must sum to exactly
  /// 10000 and every row must be > 0 (release_reward asserts
  /// winner.amount > 0 per winner — see rewards.rs); both are enforced by
  /// the `check_team_shares` constraint trigger in the migration, not by a
  /// plain CHECK, since the invariant spans every member row of a team.
  ///
  /// Remainder rule: dividing an integer prize amount by these basis
  /// points leaves a remainder, and release_reward's exact-equality assert
  /// (total_distributed == event.reward) means that remainder cannot be
  /// dropped. Rule: the remainder is added to the member with the lowest
  /// `ordinal` in the team. This is the Go release-wrapper's (#25) job to
  /// implement — nothing in this schema performs the allocation.
  shareBasisPoints Int
  /// Deterministic ordering within the team; also the tiebreak target for
  /// the remainder rule above. Unique per team, not globally.
  ordinal          Int
  createdAt        DateTime @default(now())

  team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  wallet  Wallet   @relation(fields: [walletId], references: [id])
  payouts Payout[]

  @@unique([eventId, walletId])
  @@unique([teamId, ordinal])
  @@index([teamId])
  @@index([walletId])
  @@map("team_members")
}

/// Append-only audit log. `amount` here is the NET amount actually
/// transferred (post protocol + platform fee, if any — see ADR-001), distinct
/// from Prize.amount, the gross configured amount. txHash is deliberately NOT
/// unique: `release_reward` pays every winner of an event in a single atomic
/// transaction, so every Payout produced by that one release shares the same
/// txHash. Under teams a single Prize can have several winners — one row per
/// paid team member, all sharing one txHash — so the old one-row-per-prize
/// assumption behind @@unique([prizeId, txHash]) no longer holds:
/// teamMemberId is what makes each of those N rows unique instead.
model Payout {
  id           String   @id @default(uuid())
  prizeId      String
  teamMemberId String
  txHash       String
  amount       Decimal  @db.Decimal(18, 7)
  confirmedAt  DateTime @default(now())

  prize      Prize      @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id])

  @@unique([prizeId, txHash, teamMemberId])
  @@index([prizeId])
  @@index([teamMemberId])
  @@index([txHash])
  @@map("payouts")
}

/// Idempotency key + outbox record for every escrow-mutating call to the
/// event-escrow contract. Read by the reconciliation job (E04) to heal
/// drift between confirmed on-chain transactions and mirror table state.
model OpLog {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  operation      String
  payload        Json
  status         OpStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@map("op_log")
}

/// Short-lived SEP-0043 challenge nonces. Must live in Postgres (not process
/// memory) because Vercel serverless invocations do not share a Map.
model AuthNonce {
  nonce     String   @id
  address   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([address])
  @@map("auth_nonces")
}
