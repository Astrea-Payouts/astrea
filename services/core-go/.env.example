# core-go boot-time config — see internal/config/config.go. All eight
# variables are validated by config.Load before the HTTP server starts;
# missing or malformed ones are reported together, one line per variable.

# testnet or mainnet. Defaults to testnet if unset.
STELLAR_NETWORK=testnet

# Explicit gate: STELLAR_NETWORK=mainnet alone is refused at boot unless
# this is also set to "true". Leave unset/false for testnet. Mirrors
# apps/web's ALLOW_MAINNET.
ALLOW_MAINNET=false

# Soroban RPC endpoint. Optional on testnet (defaults to the public
# testnet RPC below); required when STELLAR_NETWORK=mainnet — there is no
# free public mainnet default.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed event-escrow contract ID. Must decode as a valid Soroban
# contract strkey (starts with C) — validated via internal/escrow.ContractAddress,
# not just pattern-matched.
ESCROW_CONTRACT_ID=

# HTTP listen port. Defaults to 8080 if unset.
PORT=8080

# Direct (non-pooled) Postgres connection — the same database apps/web's
# Prisma migrates, but on port 5432, NOT apps/web's own pooled DATABASE_URL
# (port 6543, ?pgbouncer=true). pgx forwards pgbouncer=true to Postgres as
# a server runtime setting, which Postgres refuses, and the transaction-mode
# pooler breaks pgx's prepared statements — config.Load refuses to boot with
# one. Validated with pgxpool.ParseConfig, not just checked non-empty.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Shared secret this service and apps/web both hold: apps/web sends it as
# `Authorization: Bearer <token>` on every call, alongside `X-Astrea-Wallet`
# for the session's wallet. At least 32 bytes; generate with
# `openssl rand -hex 32`. Never logged — see Configuration below.
CORE_GO_SERVICE_TOKEN=

# Classic-asset issuer of the organizer-path deposit token (USDC). Its
# Soroban Asset Contract (SAC) address is derived from this at boot via
# internal/escrow.ClassicAssetContractID — never configured directly.
# Must decode as a valid Stellar account strkey (starts with G).
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
