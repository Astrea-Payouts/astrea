# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# husky's internal helper scripts - auto-generated on every `npm install`,
# already excluded by .husky/_/.gitignore but graphify's scanner only reads
# the root .gitignore, so it needs to be listed here too (#husky-noise)
/.husky/_/

# dependencies
/node_modules
.next/
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything ignored EXCEPT the .env.example templates, which
# must be tracked so contributors know which variables to set.
.env*
!.env.example
!spikes/**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# biome
.biomecache

# go (services/core-go)
services/core-go/core-go
services/core-go/*.exe
services/core-go/*.test

# graphify's dated safety backups of graphify-out/, written before each
# automated rebuild (git history is the real backup - these are local-only)
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# spike secrets and run artifacts (testnet-only, but never commit anyway)
spikes/**/.env
spikes/**/.accounts.json
spikes/**/.findings.json
spikes/**/.tw-openapi.json
spikes/**/node_modules

# superseded by spikes/k01-soroban-escrow — kept locally, not in the public repo
spikes/k01-trustless-work/

# scratch
*.bak

# graphify.
#
# Almost all of graphify-out/ is ignored: the graph is published, not committed
# (https://astrea-payouts.github.io/astrea/, rebuilt by CI on every merge to
# develop). Only cache/semantic/ is tracked - see the note at the end of this
# block. Do NOT blanket-ignore graphify-out/ itself: that hides the one
# directory that must stay visible, and it is how this file ended up telling
# contributors to run a `git add graphify-out/` that could not work.
#
# manifest.json and cache/stat-index.json store wall-clock mtimes for the local
# incremental-update cache and never match between any two checkouts; tracking
# them guaranteed a permanently dirty working tree and merge conflicts on
# generated files (2 of the 4 conflicting paths in #153). last_query_stamp is
# written by `graphify query`.
graphify-out/manifest.json
graphify-out/cache/stat-index.json
graphify-out/cache/last_query_stamp
#
# Absolute path to whichever Python has graphify installed, recorded at hook
# install time. Machine-specific by definition - graphify falls back to PATH
# detection when it is absent.
graphify-out/.graphify_python
graphify-out/.graphify_root
#
# The graph itself. Regenerating all of this costs zero tokens (structural AST
# extraction, no LLM) and about a minute, so committing it bought nothing and
# cost 7.8 MB - while guaranteeing a stale copy, since branch protection stops
# CI from pushing a refreshed one back to develop. A stale graph is worse than
# no graph: the graphify skill fast-paths onto graphify-out/graph.json when it
# exists and answers from it without noticing it is out of date.
#
# The current graph is published instead: https://astrea-payouts.github.io/astrea/
graphify-out/graph.json
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
graphify-out/cache/ast/
#
# NOT ignored, deliberately: graphify-out/cache/semantic/. That one is the
# LLM-derived extraction over the .md files (236 KB, 37 files). Regenerating it
# costs real tokens, so it stays in git and doc-driven updates stay cheap.

/apps/web/src/generated/prisma

# vendor AI-skill reference docs — `npx prisma init` regenerates these; we
# deliberately don't commit them (219 files of reference material, not
# project content). Only ignores the skill bundles, not other legitimate
# per-tool project config that might live under these same directories.
.claude/skills
.agents/skills
.windsurf/skills
skills-lock.json

# GitHub Pages staging dir, assembled by the graphify-rebuild job in CI
_site/
