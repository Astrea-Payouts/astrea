# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# biome
.biomecache

# spike secrets and run artifacts (testnet-only, but never commit anyway)
spikes/**/.env
spikes/**/.accounts.json
spikes/**/.findings.json
spikes/**/.tw-openapi.json
spikes/**/node_modules

# scratch
*.bak
