# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# husky's internal helper scripts - auto-generated on every `npm install`,
# already excluded by .husky/_/.gitignore but graphify's scanner only reads
# the root .gitignore, so it needs to be listed here too (#husky-noise)
/.husky/_/

# dependencies
/node_modules
.next/
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — everything ignored EXCEPT the .env.example templates, which
# must be tracked so contributors know which variables to set.
.env*
!.env.example
!spikes/**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# biome
.biomecache

# go (services/core-go)
services/core-go/core-go
services/core-go/*.exe
services/core-go/*.test

# graphify's dated safety backups of graphify-out/, written before each
# automated rebuild (git history is the real backup - these are local-only)
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# spike secrets and run artifacts (testnet-only, but never commit anyway)
spikes/**/.env
spikes/**/.accounts.json
spikes/**/.findings.json
spikes/**/.tw-openapi.json
spikes/**/node_modules

# superseded by spikes/k01-soroban-escrow — kept locally, not in the public repo
spikes/k01-trustless-work/

# scratch
*.bak

# Graphify_out Manifest
graphify-out/
/graphify_out/manifest.json

/apps/web/src/generated/prisma

# vendor AI-skill reference docs — `npx prisma init` regenerates these; we
# deliberately don't commit them (219 files of reference material, not
# project content). Only ignores the skill bundles, not other legitimate
# per-tool project config that might live under these same directories.
.claude/skills
.agents/skills
.windsurf/skills
skills-lock.json
